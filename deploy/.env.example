# Copy to .env on the server and fill in real values. Never commit the real .env.
# These are passed to the container at runtime via docker-compose env_file.

# --- Required ---
# OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# --- Backend (inside the container) ---
# Leave these as-is; the internal nginx proxies to 127.0.0.1:8000.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
# Since frontend + backend are served same-origin from the domain, the browser
# never makes a cross-origin call. Set this to the public origin anyway, with NO
# trailing slash and NO path (CORS origins must be scheme+host[:port] only).
ALLOWED_ORIGINS=https://gpt.medviberpro.com
